{
  "name": "@mongez/cache",
  "version": "1.3.2",
  "description": "Framework-agnostic cache facade with pluggable drivers — localStorage, sessionStorage, runtime memory, plus encrypted variants. One API, key prefixing, TTL, and a PersistAdapter-compatible shape for @mongez/atom.",
  "main": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mongez/encryption": "^1.0.x"
  },
  "devDependencies": {
    "happy-dom": "^15.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "cache",
    "cache-manager",
    "local-storage",
    "session-storage",
    "runtime-cache",
    "memory-cache",
    "encryption-local-storage",
    "encrypted-session-storage",
    "browser-cache",
    "browser",
    "ttl",
    "expiration",
    "key-prefix",
    "persist-adapter",
    "storage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanzohdy/mongez-cache"
  },
  "author": "hassanzohdy",
  "license": "MIT"
}
